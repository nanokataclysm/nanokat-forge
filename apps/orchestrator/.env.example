# Required provider configuration
DASHSCOPE_API_KEY=replace-with-your-provider-key
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DEMO_SHARED_SECRET=replace-with-a-long-random-demo-secret

# Optional runtime configuration
QWEN_MODEL=qwen-plus
PORT=9000
NODE_ENV=development
FORCE_SECURE_COOKIES=false
DEBUG_ERRORS=false

# Smoke-test target. Keep credentials outside this file.
FORGE_URL=http://localhost:9000
